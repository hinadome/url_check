# URL Checker — optional runtime feature gates (Node process env).
# Defaults: both allowed when unset. Restart the app after changes.
# Disable with: 0 | false | no | off

# ALLOW_IGNORE_CERT_ERRORS=1
# ALLOW_CAPTURE_HAR=1

# To disable on a shared/public host:
# ALLOW_IGNORE_CERT_ERRORS=0
# ALLOW_CAPTURE_HAR=0
