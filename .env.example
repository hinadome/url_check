# URL Checker — optional runtime feature gates (Node process env).
# Defaults: allowed when unset. Restart the app after changes.
# Disable with: 0 | false | no | off

# ALLOW_IGNORE_CERT_ERRORS=1
# ALLOW_CAPTURE_HAR=1
# ALLOW_CAPTURE_NETLOG=1
# ALLOW_HTTP_PROTOCOL_CONTROLS=1

# To disable on a shared/public host:
# ALLOW_IGNORE_CERT_ERRORS=0
# ALLOW_CAPTURE_HAR=0
# ALLOW_CAPTURE_NETLOG=0
# ALLOW_HTTP_PROTOCOL_CONTROLS=0

# Max failed / aborted network rows (requestfailed) returned per check (default 500)
# MAX_NETWORK_FAILED_ENTRIES=500
