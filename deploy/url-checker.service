[Unit]
Description=URL Checker (Next.js + Playwright)
After=network.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PORT=__PORT__
Environment=HOSTNAME=__HOST__
# Optional feature gates (default allow when unset). Disable with 0/false/no/off:
# Environment=ALLOW_IGNORE_CERT_ERRORS=0
# Environment=ALLOW_CAPTURE_HAR=0
# Environment=ALLOW_CAPTURE_NETLOG=0
# Environment=ALLOW_HTTP_PROTOCOL_CONTROLS=0
# Cap failed / aborted network rows (requestfailed) per check (default 500):
# Environment=MAX_NETWORK_FAILED_ENTRIES=500
# Environment=MAX_SSRF_BLOCKED_ENTRIES=500
# Environment=ENABLE_SSRF_BROWSER_GUARD=0
# Access control (default off) — see README Access control:
# Environment=ENABLE_NETWORK_ACL=1
# Environment=NETWORK_ACL_ALLOWLIST=203.0.113.0/24,198.51.100.10
# Environment=ENABLE_RATE_LIMIT=1
# Environment=RATE_LIMIT_MAX=10
# Environment=RATE_LIMIT_WINDOW_MS=60000
# Environment=TRUST_PROXY=1
ExecStart=__NODE_BIN__ __APP_DIR__/node_modules/next/dist/bin/next start -H __HOST__ -p __PORT__
Restart=on-failure
RestartSec=5
# Chromium / Playwright often need shared memory
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
